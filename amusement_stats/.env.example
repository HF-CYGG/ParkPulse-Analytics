DJANGO_SECRET_KEY=change-me-use-a-long-random-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,your-domain.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example.com
DJANGO_DB_PATH=/app/data/db.sqlite3
DJANGO_MEDIA_ROOT=/app/media
DJANGO_STATIC_ROOT=/app/staticfiles
DJANGO_SECURE_PROXY_SSL_HEADER=1
QUEUE_API_KEY=change-me
PORT=8000
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
